# Copy to .env.local and fill in:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# This file has to live here, not at the repository root. Next.js loads .env
# files from its own project directory - the one holding next.config.ts - and
# `npm run dev` runs `next dev` with that directory as the working directory.
# A NEXT_PUBLIC_* value placed in the root .env is read by nothing: the API
# does not want it and Next never looks there, so the web app falls back to
# its defaults and renders the setup page as though nothing were configured.
#
# Everything here is inlined into the browser bundle at build time, so only
# genuinely public values belong in this file. Server-only secrets
# (API_KEY_PEPPER, CREDENTIAL_KEKS, MIGRATION_DATABASE_URL, a Supabase
# service-role key) go in the root .env and must never be given a
# NEXT_PUBLIC_ name - the prefix is what publishes them.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# From the Supabase project's API settings. The anon key is designed to ship
# to the browser and is safe here; the service-role key is not, and
# AgentWorld never needs it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
