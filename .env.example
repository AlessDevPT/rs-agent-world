# Copy to .env and fill in. No secret has a working default: settings.py fails
# fast at boot on a missing required variable rather than at first request.

# ---------------------------------------------------------------- apps/api ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json  (json in deployed envs)

DATABASE_URL=postgresql+asyncpg://agentworld:dev@localhost:5432/agentworld
REDIS_URL=redis://localhost:6379/0

# Fan-out implementation. "inprocess" needs no Redis and only works with a
# single API worker; "redis" is required for more than one.
EVENT_BUS=inprocess

# Supabase Auth. Verification is JWKS-based, so no secret is needed here.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Argon2id pepper for API-key secrets. Rotatable; rotating invalidates keys.
API_KEY_PEPPER=

DEFAULT_HEARTBEAT_TTL_SECONDS=60
WS_REPLAY_WINDOW_EVENTS=10000
INGEST_MAX_BATCH_EVENTS=500
INGEST_MAX_FUTURE_SKEW_SECONDS=300

CORS_ORIGINS=http://localhost:3000

OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
