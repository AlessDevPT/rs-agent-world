# Copy to .env and fill in. No secret has a working default: settings.py fails
# fast at boot on a missing required variable rather than at first request.

# ---------------------------------------------------------------- apps/api ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json  (json in deployed envs)

# The application connects as agentworld_app, which is NOT a superuser and
# NOT the schema owner - a superuser silently bypasses the row-level security
# policies in migration 0004. MIGRATION_DATABASE_URL is the owner, used only
# by `alembic upgrade`.
DATABASE_URL=postgresql+asyncpg://agentworld_app:app@localhost:5432/agentworld
MIGRATION_DATABASE_URL=postgresql+asyncpg://agentworld:dev@localhost:5432/agentworld
REDIS_URL=redis://localhost:6379/0

# Fan-out implementation. "inprocess" needs no Redis and only works with a
# single API worker; "redis" is required for more than one.
EVENT_BUS=inprocess

# Supabase Auth. Verification is JWKS-based, so no secret is needed here.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Argon2id pepper for API-key secrets. Rotatable; rotating invalidates keys.
API_KEY_PEPPER=

# Key-encryption keys for `credentials`, as {"<id>": "<base64 of 32 bytes>"},
# and the id of the one that wraps new data keys. Several may be listed at
# once: that is what makes rotation additive - add a key, point ACTIVE at it,
# re-wrap, retire the old one when no row still names it.
#
# Leaving both empty uses a fixed development key with the id
# `local-dev-insecure`, which staging and production refuse - by key material,
# not by id, so renaming it does not get it past. Generate a real one with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_KEKS=
CREDENTIAL_ACTIVE_KEK_ID=

DEFAULT_HEARTBEAT_TTL_SECONDS=60
WS_REPLAY_WINDOW_EVENTS=10000
INGEST_MAX_BATCH_EVENTS=500
INGEST_MAX_FUTURE_SKEW_SECONDS=300

CORS_ORIGINS=http://localhost:3000

OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
