# Copy to .env and fill in. No secret has a working default: settings.py fails
# fast at boot on a missing required variable rather than at first request.

# ---------------------------------------------------------------- apps/api ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json  (json in deployed envs)

# The application connects as agentworld_app, which is NOT a superuser and
# NOT the schema owner - a superuser silently bypasses the row-level security
# policies in migration 0004. MIGRATION_DATABASE_URL is the owner, used only
# by `alembic upgrade`.
DATABASE_URL=postgresql+asyncpg://agentworld_app:app@localhost:5432/agentworld
MIGRATION_DATABASE_URL=postgresql+asyncpg://agentworld:dev@localhost:5432/agentworld
REDIS_URL=redis://localhost:6379/0

# Fan-out implementation. "inprocess" needs no Redis and only works with a
# single API worker; "redis" is required for more than one.
EVENT_BUS=inprocess

# Supabase Auth. Verification is JWKS-based, so no secret is needed here.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Argon2id pepper for API-key secrets. Rotatable; rotating invalidates keys.
API_KEY_PEPPER=

# Key-encryption keys for `credentials`, as {"<id>": "<base64 of 32 bytes>"},
# and the id of the one that wraps new data keys. Several may be listed at
# once: that is what makes rotation additive - add a key, point ACTIVE at it,
# re-wrap, retire the old one when no row still names it.
#
# Leaving both empty uses a fixed development key with the id
# `local-dev-insecure`, which staging and production refuse - by key material,
# not by id, so renaming it does not get it past. Generate a real one with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_KEKS=
CREDENTIAL_ACTIVE_KEK_ID=

DEFAULT_HEARTBEAT_TTL_SECONDS=60
INGEST_MAX_BATCH_EVENTS=500
INGEST_MAX_FUTURE_SKEW_SECONDS=300

# ---------------------------------------------------------- the realtime spine ---
# How far back a `resume` cursor may reach. A cursor more than this many
# events behind the project's latest is answered with `resync_required` and
# nothing else, and so is one whose rows are no longer retained.
WS_REPLAY_WINDOW_EVENTS=10000
# How long a WebSocket ticket is worth, and it is worth one connection.
WS_TICKET_TTL_SECONDS=60
# Frames held for one socket before it is dropped with `resync_required`.
WS_OUTBOUND_QUEUE_FRAMES=256
# The floor on delta latency: how often the publisher looks for committed
# event rows it has not published, and how many it turns into frames per pass.
REALTIME_PUBLISH_INTERVAL_SECONDS=0.25
REALTIME_PUBLISH_BATCH_ROWS=200
# Whether the API process runs the publisher in its lifespan. It must on the
# `inprocess` bus, where no other process can reach the sockets it holds; on
# `redis` the worker hosts it and this is ignored.
REALTIME_PUBLISH_IN_API=true

CORS_ORIGINS=http://localhost:3000

OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- apps/web ---
# Not here. Next.js loads .env files from its own project directory, so the
# web app's NEXT_PUBLIC_* values live in apps/web/.env.local and a copy of
# them in this file is read by nothing:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# See apps/web/.env.example for the variables and why the prefix matters.
